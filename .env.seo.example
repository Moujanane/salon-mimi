# Variables du rapport SEO quotidien — copier en .env.seo (jamais commité).
# OAuth utilisateur Google Search Console (lecture seule).
GSC_OAUTH_CLIENT_ID=xxxxx.apps.googleusercontent.com
GSC_OAUTH_CLIENT_SECRET=GOCSPX-xxxxx
GSC_OAUTH_REFRESH_TOKEN=1//xxxxx
# Valeur EXACTE renvoyée par l'API GSC /sites. Pour Salon Mimi c'est une propriété "Préfixe d'URL" :
GSC_SITE_URL=https://mimi-coiffure.com/
